generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String
  createdAt    DateTime      @default(now())
  sessions     Session[]
  profile      Profile?
  jobs         Job[]
  applications Application[]
  setting      Setting?
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String?
  email        String?
  phone        String?
  location     String?
  resumeJson   String
  rawText      String?
  originalFile String?
  originalName String?
  preferences  String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Job {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String?
  title        String?
  company      String?
  location     String?
  description  String?
  details      String           @default("{}")
  sourceText   String?
  status       String           @default("importing")
  error        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tailored     TailoredResume[]
  applications Application[]

  @@index([userId])
}

model TailoredResume {
  id              String   @id @default(cuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeJson      String
  coverLetter     String?
  changes         String   @default("[]")
  matchScore      Int?
  missingKeywords String   @default("[]")
  pdfPath         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Application {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status          String    @default("queued")
  autoSubmit      Boolean   @default(true)
  summary         String?
  log             String    @default("[]")
  cancelRequested Boolean   @default(false)
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([userId])
}

model Setting {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  model      String?
  headless   Boolean @default(false)
  autoSubmit Boolean @default(true)
}
